{
  "productName": "FileScanner",
  "version": "1.2.3",
  "identifier": "com.filescanner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "app": {
    "windows": [
      {
        "title": "FileScanner — Moteur d'Analyse de Sécurité",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://filescanner-app.heiphaistos.org/maj/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RkQxMEJCRDZGRTE0NTEKUldSUkZQN1d1eEQ5eUhTQ28vdVR2a1FtVU5IdG5jVllBZXRxdWFwSXZwSGZHVm9JSWoxUVk2dWEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
